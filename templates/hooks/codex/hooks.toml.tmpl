# agentic-mesh-ai-kit/templates/hooks/codex/hooks.toml.tmpl
# 落点：merge 到 ~/.codex/config.toml [hooks] 段
# Codex 的 hook 表面较小（6 个核心事件），靠 OS sandbox 兜底

[hooks]
pre_exec_filter    = "scripts/hooks/check-no-verify.sh"          # 命令执行前
pre_write_filter   = "scripts/hooks/check-no-secrets.sh"         # 写文件前
post_edit          = "scripts/hooks/lint-changed.sh"             # 编辑后
post_commit        = "scripts/hooks/check-closes-issue.sh"       # commit 后
session_start      = "scripts/hooks/check-needs-clarification.sh" # 会话启动
session_stop       = "scripts/hooks/check-task-verification.sh"  # 会话结束
